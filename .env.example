# PostgreSQL Test Database Connection
# Copy this file to .env and fill in your values
# The .env file is gitignored and won't be committed

# ============================================================================
# Option 1: Docker PostgreSQL (Recommended for local testing)
# ============================================================================
# Start PostgreSQL with: ./scripts/test-docker.sh up
# Or use docker compose directly: docker compose -f docker-compose.test.yml --profile test up -d postgres-test
TEST_POSTGRES_DSN=postgres://postgres:testpassword@localhost:5433/postgres?sslmode=disable
TEST_POSTGRES_ADMIN=1

# Admin mode settings:
#   TEST_POSTGRES_ADMIN=1  - Admin mode (can create/drop databases, tests run in parallel)
#   TEST_POSTGRES_ADMIN=0  - Table-level mode (tests run sequentially, safer for shared DB)

# ============================================================================
# Option 2: Supabase or other remote PostgreSQL
# ============================================================================
# For Supabase (non-admin mode - table-level isolation):
# TEST_POSTGRES_DSN=postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# TEST_POSTGRES_ADMIN=0

# ============================================================================
# Option 3: Local PostgreSQL (non-Docker)
# ============================================================================
# If you have PostgreSQL installed locally:
# TEST_POSTGRES_DSN=postgres://postgres:password@localhost:5432/postgres?sslmode=disable
# TEST_POSTGRES_ADMIN=1
