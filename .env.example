# PostgreSQL Test Database Connection
# Copy this file to .env and fill in your values
# The .env file is gitignored and won't be committed

# For local Docker PostgreSQL (default)
# TEST_POSTGRES_DSN=postgres://postgres:password@localhost:5433/postgres?sslmode=disable

# For Supabase or other remote PostgreSQL
# TEST_POSTGRES_DSN=postgresql://user:password@host:5432/postgres?sslmode=require
