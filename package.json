{
  "scripts": {
    "postinstall": "node scripts/patch-patchright-openbsd.js && npm run setup:go",
    "setup:go": "echo '🐹 Setting up Go dependencies...' && go mod download && go mod tidy && echo '🗄️  Generating sqlc code...' && sqlc generate && echo '✅ Go setup complete'",
    "setup": "npm install --legacy-peer-deps",
    "build": "cd web/admin && npx vite build && cd ../site && npx vite build",
    "test:e2e": "npm run build && patchright test",
    "test:e2e:nobuild": "patchright test",
    "test:e2e:ui": "patchright test --ui",
    "test:e2e:debug": "patchright test --debug",
    "test:e2e:report": "patchright show-report",
    "devrun": "cd web/admin && npx vite build && cd ../site && npx vite build && cd ../.. && sh -c 'if [ -f .env ]; then export $(grep -v \"^#\" .env | xargs); fi && go run ./cmd serve'",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "patchright": "^1.61.1"
  },
  "devDependencies": {
    "@nolebase/vitepress-plugin-enhanced-readabilities": "^2.18.2",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "mermaid": "^11.16.1",
    "vitepress": "^2.0.0-alpha.19",
    "vitepress-plugin-collapse": "^0.12.0",
    "vitepress-plugin-diagrams": "^1.3.1",
    "vitepress-plugin-llms": "^1.13.4",
    "vitepress-plugin-mark": "^0.12.0",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitepress-plugin-pdf": "^0.12.0",
    "vitepress-plugin-plantuml": "^0.12.0",
    "vitepress-plugin-qrcode": "^0.12.0",
    "vitepress-plugin-steps": "^0.12.0",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitepress-plugin-video": "^0.12.0"
  }
}
