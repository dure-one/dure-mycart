# Domain configuration
DOMAIN=yourdomain.com

# Admin email (used for SSL certificates and mycart admin)
ADMIN_EMAIL=admin@example.com

# Admin password for mycart installation
ADMIN_PASSWORD=YourSecurePass

# Database (optional)
#
# Empty means the embedded SQLite database in ./lc_base, which is the default
# and what an existing installation uses. Set both to run on PostgreSQL
# instead, after starting it with:
#
#   docker compose --profile postgres up -d
#
# The connection string is read by the container, so the host is the compose
# service name, not localhost. myCart adds timezone=UTC itself and refuses a
# connection whose session is not UTC.
# MYCART_DB_DRIVER=postgres
# MYCART_DB_DSN=postgres://mycart:change-me@postgres:5432/mycart?sslmode=disable

# PostgreSQL container (only used with the "postgres" profile)
# POSTGRES_DB=mycart
# POSTGRES_USER=mycart
# POSTGRES_PASSWORD=change-me
