# Docker Environment Configuration Example
# Copy this file to .env and customize for your deployment

# ============================================
# Database Configuration
# ============================================

# Database type: "sqlite" or "postgres"
DB_TYPE=sqlite

# ============================================
# SQLite Configuration (when DB_TYPE=sqlite)
# ============================================

SQLITE_PATH=/data/mycart.db

# ============================================
# PostgreSQL Configuration (when DB_TYPE=postgres)
# ============================================

# PostgreSQL connection details
POSTGRES_DB=mycart
POSTGRES_USER=mycart
POSTGRES_PASSWORD=changeme_secure_password_here

# Option 1: Connection String (Recommended)
# Use this for Supabase or external PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/database

# Option 2: Individual Parameters (for docker-compose postgres service)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mycart
DB_USER=mycart
DB_PASSWORD=changeme_secure_password_here
DB_SSLMODE=disable

# PostgreSQL Connection Pooling
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300

# ============================================
# Application Configuration
# ============================================

# Port mapping (host:container)
MYCART_PORT=8080

# ============================================
# Docker Compose Usage
# ============================================

# SQLite (default):
#   docker-compose up
#
# PostgreSQL (local):
#   DB_TYPE=postgres docker-compose --profile postgres up
#
# PostgreSQL (external/Supabase):
#   Set DATABASE_URL in .env, then:
#   DB_TYPE=postgres docker-compose up
