# Stage 1: Build frontend assets
FROM node:22-alpine AS frontend-build

WORKDIR /app

# Copy frontend source
COPY web/admin ./web/admin
COPY web/site ./web/site

# Build admin panel
WORKDIR /app/web/admin
RUN npm ci
RUN npx vite build

# Build site
WORKDIR /app/web/site
RUN npm ci
RUN npx vite build

# Stage 2: Build Go binary
FROM golang:alpine AS backend-build

WORKDIR /go/src/app

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy all source code
COPY . .

# Copy built frontend from previous stage
COPY --from=frontend-build /app/web/admin/build ./web/admin/build
COPY --from=frontend-build /app/web/site/build ./web/site/build

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o /go/bin/mycart ./cmd/main.go

# Stage 3: Final runtime image
FROM gcr.io/distroless/static-debian12

COPY --from=backend-build /go/bin/mycart /mycart

EXPOSE 8080

ENTRYPOINT ["/mycart"]
CMD ["serve"]
