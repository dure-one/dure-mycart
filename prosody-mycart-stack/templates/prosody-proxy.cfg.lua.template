-- Prosody PROXY protocol configuration
-- Rendered by the prosody-config-init service (substitutes ${XMPP_DOMAIN})
-- into generated/proxy.cfg.lua, which is what actually
-- gets mounted at /etc/prosody/conf.d/proxy.cfg.lua. Edit this template,
-- not the generated file directly.
-- IMPORTANT: Settings in this file are loaded AFTER VirtualHost, so some settings
-- need to be applied at the global level via the main config

---------- GLOBAL SETTINGS (apply before VirtualHost) ----------

-- Add pidfile for health checks
pidfile = "/var/run/prosody/prosody.pid"

-- Logging: this table replaces (not merges with) the prosody image's own
-- default `log = { [LOGLEVEL] = "*console" }` from /etc/prosody/prosody.cfg.lua,
-- since conf.d is loaded after it and Lua assignment overwrites the global.
-- Re-adds console (so `docker logs prosody` keeps working) and adds a file
-- sink other tools can tail - notably fail2ban-rs's xmpp-auth/xmpp-s2s-abuse
-- jails, which read /var/log/prosody/prosody.log (mounted through to
-- prosody-mycart-stack as /logs/prosody/prosody.log) and had nothing to read
-- before this, since Prosody never wrote to a file at all.
log = {
    { to = "console", levels = { min = "info" } };
    { to = "file", filename = "/var/log/prosody/prosody.log", levels = { min = "info" } };
}

-- PROXY protocol support via custom mod_net_proxy (supports proxy_out)
-- Custom modules take priority over community modules
plugin_paths = { "/usr/lib/prosody/custom", "/usr/lib/prosody/community" }

---------- PROXY PROTOCOL CONFIGURATION (MUST BE GLOBAL) ----------

-- Trust connections from xmpp-proxy only
-- xmpp-proxy handles ALL XMPP traffic (ALPN, QUIC, Direct TLS)
-- This MUST be set before proxy_port_mappings
proxy_trusted_proxies = {
    "127.0.0.1",      -- localhost
    "::1",            -- localhost IPv6
    -- Docker bridge network (xmpp-internal) subnet is pinned in docker-compose.yml
    -- to 172.19.0.0/16, so we trust only that subnet instead of the entire
    -- 172.16.0.0/12 range (268M IPs). dure-mycart container (where xmpp-proxy
    -- runs) gets dynamic IP within this /16 (typically .3 or .4).
    "172.19.0.0/16"
}

-- Configure which ports expect PROXY protocol headers
proxy_port_mappings = {
    [5222] = "c2s",  -- Client-to-server connections
    [5269] = "s2s"   -- Server-to-server with PROXY protocol (from xmpp-proxy)
}

-- Mark incoming connections from proxy as secure (xmpp-proxy guarantees this)
proxy_secure_in = true

-- Disable regular c2s ports (mod_net_proxy will handle incoming c2s)
c2s_ports = {}

-- MUST have at least one s2s_port for outgoing S2S to work
-- Empty s2s_ports causes Prosody to fall back to default 5269, conflicting with proxy_port_mappings
s2s_ports = {15268}

-- Outgoing S2S via xmpp-proxy outgoing listener (for federation)
-- xmpp-proxy runs in dure-mycart container, accessible via Docker DNS
proxy_out = { "dure-mycart", 15270 }
proxy_secure = true

-- Don't require encryption for INCOMING connections (xmpp-proxy handled TLS)
c2s_require_encryption = false

-- For OUTGOING S2S: Disable encryption (xmpp-proxy handles TLS via proxy_out)
-- Prosody sends plain-text to xmpp-proxy:15270, which then connects with TLS to remote servers
s2s_require_encryption = false
-- VERIFIED SECURE: xmpp-proxy validates remote S2S certificates (see XMPP-PROXY-S2S-CERT-VALIDATION.md)
-- Certificate validation happens in xmpp-proxy using XmppServerCertVerifier against CA roots
s2s_secure_auth = false

-- Allow plaintext auth for incoming C2S (TLS already handled by xmpp-proxy)
allow_unencrypted_plain_auth = true

---------- MODULE CONFIGURATION ----------

-- Enable additional modules (these will be added to the global modules_enabled)
modules_enabled = {
    -- Core modules (must be explicitly enabled)
    "roster";        -- User contact list
    "saslauth";      -- SASL authentication
    "tls";           -- TLS support
    "disco";         -- Service discovery
    "dialback";      -- S2S authentication

    -- OMEMO/Encryption support (requires PEP)
    "pep";           -- Personal Eventing Protocol (required for OMEMO)
    "blocklist";     -- Block list support
    "carbons";       -- Message carbons
    "smacks";        -- Stream management
    "csi_simple";    -- Client state indication
    "mam";           -- Message Archive Management

    -- Proxy-specific modules
    "net_proxy";     -- Parse PROXY protocol v1/v2 headers to extract real client IP

    -- Auth logging: mod_saslauth fires an authentication-failure event but
    -- doesn't itself log anything for a plain wrong-password/unknown-user
    -- failure - without this, fail2ban-rs's xmpp-auth jail has no log line
    -- to match, no matter how log_path/level is configured. Default mode
    -- ("failure") logs "Failed authentication attempt (<condition>) for
    -- user <user>@<host> from IP: <ip>" at info level - see fail2ban-rs's
    -- xmpp-auth jail filter, which matches this exact wording.
    "log_auth";      -- Log authentication successes/failures (community module)

    -- Security & Anti-Spam modules
    "ipcheck";       -- DNS blacklist (RBL/DNSBL) checking for connections
    "anti_spam";     -- User-based spam blocking (complements fail2ban-rs IP blocking)

    -- Monitoring & Performance modules
    "log_slow_events"; -- Log slow event handlers (performance debugging)
    "server_status";   -- Server status monitoring page
    "stanza_counter";  -- Count XMPP stanzas for metrics

    -- Message handling
    "pastebin";      -- Convert large messages to pastebin (NOT encrypted)

    -- Rate limiting (core module)
    "limits";        -- Connection and bandwidth limits

    -- HTTP/Admin modules (always enabled)
    "http";          -- HTTP server for web admin
    "admin_web2";    -- Web admin interface (Prosody 13.0 compatible)

    -- User management (mod_register DISABLED for security - no rate limiting)
    -- "register";      -- User registration (DISABLED: no rate limiting = spam vector)
    "ping";          -- XMPP ping
    "time";          -- Time queries
    "version";       -- Version queries
    "uptime";        -- Uptime queries
    "vcard4";        -- vCard support
    "vcard_legacy";  -- Legacy vCard
    "bookmarks";     -- Bookmarks (for chat rooms)
    "private";       -- Private XML storage
}

-- Conditional admin modules (ENV-configurable, default: enabled)
if Lua.os.getenv("PROSODY_ENABLE_ADMIN_ADHOC") ~= "false" then
    Lua.table.insert(modules_enabled, "admin_adhoc")
end

if Lua.os.getenv("PROSODY_ENABLE_ADMIN_SHELL") ~= "false" then
    Lua.table.insert(modules_enabled, "admin_shell")
end

-- Conditional HTTP modules (ENV-configurable, default: enabled)
-- NOTE: BOSH required for web admin interface XMPP connection
if Lua.os.getenv("PROSODY_ENABLE_BOSH") ~= "false" then
    Lua.table.insert(modules_enabled, "bosh")
end

if Lua.os.getenv("PROSODY_ENABLE_WEBSOCKET") ~= "false" then
    Lua.table.insert(modules_enabled, "websocket")
end

-- Registration watcher (only if watchers configured)
if Lua.os.getenv("PROSODY_REGISTRATION_WATCHERS") then
    Lua.table.insert(modules_enabled, "watchregistrations")
end

---------- HTTP/BOSH CONFIGURATION ----------

-- HTTP configuration for web admin
http_ports = { 5280 }
-- SECURITY: Bind to localhost only (access via mycart reverse proxy with auth)
-- Prevents direct access from bridge network
http_interfaces = { "127.0.0.1", "::1" }

-- Trust reverse proxy (mycart) for X-Forwarded-For headers
-- This preserves real client IPs in HTTP/BOSH connections (admin interface)
trusted_proxies = { "172.19.0.3" }  -- mycart container IP on xmpp-internal network

-- BOSH configuration
consider_bosh_secure = true  -- Trust BOSH connections as secure (TLS handled by xmpp-proxy)
bosh_max_inactivity = 60     -- Keep BOSH sessions alive for 60 seconds of inactivity
bosh_max_wait = 30           -- Maximum time (in seconds) a client can wait for a response (reduced from 120s for DoS mitigation)

-- Force SASL mechanisms on insecure connections (BOSH over HTTP)
sasl_mech_override = {
    ["PLAIN"] = function() return true; end;
}

-- HTTP CORS headers for web admin
http_default_host = "${XMPP_DOMAIN}"
http_external_url = "https://${XMPP_DOMAIN}/"

-- Mount admin_web2 under /prosody/admin to match the nginx reverse-proxy
-- path (see prosody-mycart-stack/nginx-proxy-ctl). This makes Prosody's own
-- request path (and its trailing-slash redirect) match the external URL,
-- so nginx doesn't need to rewrite response headers to compensate.
-- bosh is intentionally left at its default "/http-bind" since admin_web2's
-- bundled main.js hardcodes that root-relative path.
http_paths = {
    admin = "/prosody/admin";
}

---------- PEP/OMEMO CONFIGURATION ----------

-- PEP (Personal Eventing Protocol) configuration for OMEMO support
pep_max_items = 1000  -- Maximum items per PEP node (OMEMO needs this for device lists)

---------- ADMIN CONFIGURATION ----------

-- Admin shell socket path (for prosodyctl shell command)
admin_socket = "/var/run/prosody/prosody.sock"

-- Force SASL mechanisms to be offered (for BOSH over HTTP from localhost)
c2s_direct_tls_ports = {}
authentication = "internal_hashed"

---------- DANE/DNSSEC CONFIGURATION ----------

-- DANE (DNS-Based Authentication of Named Entities)
-- Provides additional security for S2S connections via DNSSEC
-- Requires: lua-unbound, dns-root-data packages
use_dane = Lua.os.getenv("PROSODY_USE_DANE") == "true"

if use_dane then
    unbound = {
        -- Root trust anchors for DNSSEC validation
        -- Debian/Ubuntu: install 'dns-root-data' package
        trustfile = "/usr/share/dns/root.ds";
        -- DNS resolvers for queries (populated from ENV)
        forward = {};
    }

    -- Parse comma-separated DNS resolvers from ENV
    local dns_resolvers = Lua.os.getenv("PROSODY_DNS_RESOLVERS") or "8.8.8.8,1.1.1.1"
    for resolver in dns_resolvers:gmatch("[^,]+") do
        Lua.table.insert(unbound.forward, resolver:match("^%s*(.-)%s*$"))  -- trim whitespace
    end
end

---------- REGISTRATION CONFIGURATION ----------

-- User self-registration (disabled by default for security)
-- Set PROSODY_ALLOW_REGISTRATION=true to enable
allow_registration = Lua.os.getenv("PROSODY_ALLOW_REGISTRATION") == "true"

-- Welcome message for new users (variables: $username, $host)
welcome_message = Lua.os.getenv("PROSODY_WELCOME_MESSAGE") or "Welcome $username to $host XMPP server!"

-- Registration watchers (notify admins of new registrations)
-- Requires mod_watchregistrations to be enabled
local reg_watchers = Lua.os.getenv("PROSODY_REGISTRATION_WATCHERS")  -- comma-separated JIDs
if reg_watchers then
    registration_watchers = {}
    for jid in reg_watchers:gmatch("[^,]+") do
        Lua.table.insert(registration_watchers, jid:match("^%s*(.-)%s*$"))  -- trim whitespace
    end
    registration_notification = Lua.os.getenv("PROSODY_REGISTRATION_NOTIFICATION")
                              or "User $username just registered on $host"
end

---------- S2S SECURITY CONFIGURATION ----------

-- IMPORTANT: s2s_secure_auth = false is CORRECT for this architecture
-- Certificate validation happens in xmpp-proxy (see XMPP-PROXY-S2S-CERT-VALIDATION.md)
-- Prosody → plaintext → xmpp-proxy → TLS (with cert validation) → remote server
-- Setting this to true would BREAK federation!

-- S2S stanza size limit (default: 512KB)
s2s_stanza_size_limit = Lua.tonumber(Lua.os.getenv("PROSODY_S2S_STANZA_LIMIT")) or 512000

-- Insecure domains (allow dialback for specific servers)
local s2s_insecure = Lua.os.getenv("PROSODY_S2S_INSECURE_DOMAINS")  -- comma-separated
if s2s_insecure then
    s2s_insecure_domains = {}
    for domain in s2s_insecure:gmatch("[^,]+") do
        Lua.table.insert(s2s_insecure_domains, domain:match("^%s*(.-)%s*$"))
    end
end

-- Secure domains (require valid certs even with s2s_secure_auth=false)
-- Note: xmpp-proxy already validates all S2S certs, this is belt-and-suspenders
local s2s_secure = Lua.os.getenv("PROSODY_S2S_SECURE_DOMAINS")
if s2s_secure then
    s2s_secure_domains = {}
    for domain in s2s_secure:gmatch("[^,]+") do
        Lua.table.insert(s2s_secure_domains, domain:match("^%s*(.-)%s*$"))
    end
end

---------- STORAGE CONFIGURATION ----------

-- Storage backend selection
-- internal: Flat files in /var/lib/prosody (default)
-- sql: Database backend (requires sql config below)
-- NOTE: Empty string for PROSODY_SQL_DRIVER is treated as "not set" (uses file storage)
local sql_driver = Lua.os.getenv("PROSODY_SQL_DRIVER") or ""
sql_driver = sql_driver:match("^%s*(.-)%s*$")  -- trim whitespace

if sql_driver ~= "" then
    -- SQL backend explicitly configured
    storage = "sql"
    sql = {
        driver = sql_driver;  -- SQLite3, MySQL, PostgreSQL
        database = Lua.os.getenv("PROSODY_SQL_DB") or "prosody";
        username = Lua.os.getenv("PROSODY_SQL_USERNAME") or "prosody";
        password = Lua.os.getenv("PROSODY_SQL_PASSWORD");
        host = Lua.os.getenv("PROSODY_SQL_HOST") or "localhost";
    }
else
    -- File-based storage (default)
    storage = Lua.os.getenv("PROSODY_STORAGE") or "internal"
end

---------- ARCHIVING CONFIGURATION (MAM - XEP-0313) ----------

-- Default archive policy (true = archive all messages by default)
local mam_policy = Lua.os.getenv("PROSODY_MAM_DEFAULT_POLICY")
if mam_policy == nil or mam_policy == "true" then
    default_archive_policy = true
else
    default_archive_policy = false
end

-- Archive cleanup interval (default: 4 hours)
archive_cleanup_interval = Lua.tonumber(Lua.os.getenv("PROSODY_MAM_CLEANUP_INTERVAL")) or 4*60*60

-- Archive expiry period (default: 14 days / 2 weeks)
local archive_days = Lua.os.getenv("PROSODY_ARCHIVE_EXPIRY_DAYS")
                  or Lua.os.getenv("PROSODY_RETENTION_DAYS")
                  or "14"
archive_expires_after = archive_days .. "d"

-- Maximum archive query results
max_archive_query_results = Lua.tonumber(Lua.os.getenv("PROSODY_MAM_MAX_RESULTS")) or 20

---------- STATISTICS CONFIGURATION ----------

-- Enable statistics collection for monitoring
-- Set PROSODY_STATISTICS to enable (e.g., "internal")
-- NOTE: Empty string is treated as "not set" (statistics disabled)
local stats_provider = Lua.os.getenv("PROSODY_STATISTICS") or ""
stats_provider = stats_provider:match("^%s*(.-)%s*$")  -- trim whitespace

if stats_provider ~= "" then
    statistics = stats_provider  -- "internal" or other provider
end
-- If empty, statistics remains unset (disabled by default)

-- Statistics collection interval in seconds (default: 60)
local stats_interval = Lua.os.getenv("PROSODY_STATISTICS_INTERVAL")
if stats_interval then
    statistics_interval = Lua.tonumber(stats_interval) or stats_interval
end

---------- MUC (Multi-User Chat) CONFIGURATION ----------

-- MUC message archiving (muc_mam)
muc_log_by_default = Lua.os.getenv("PROSODY_MUC_LOG_DEFAULT") == "true"
muc_log_presences = Lua.os.getenv("PROSODY_MUC_LOG_PRESENCES") == "true"
log_all_rooms = Lua.os.getenv("PROSODY_MUC_LOG_ALL_ROOMS") == "true"

-- MUC archive expiry
local muc_expiry = Lua.os.getenv("PROSODY_MUC_LOG_EXPIRES") or "14"  -- days
muc_log_expires_after = muc_expiry .. "d"

-- MUC cleanup interval (default: 4 hours)
muc_log_cleanup_interval = Lua.tonumber(Lua.os.getenv("PROSODY_MUC_CLEANUP_INTERVAL")) or 4*60*60

---------- SECURITY MODULE CONFIGURATION ----------

-- mod_ipcheck: DNS blacklist checking
-- Checks connecting IPs against RBL/DNSBL services
ipcheck_mode = "block"  -- "block" | "warn" | "log"
ipcheck_lists = {
    "xbl.spamhaus.org";
    "dnsbl.sorbs.net";
    "bl.spamcop.net";
}

-- mod_anti_spam: User-based spam blocking
-- Complements fail2ban-rs (IP blocking) with user-level spam detection
anti_spam_check_messages = true
anti_spam_check_presence = false
anti_spam_check_subscriptions = true
anti_spam_check_muc = false  -- Disable for MUC (group chat) - not used yet

---------- MONITORING MODULE CONFIGURATION ----------

-- mod_log_slow_events: Performance monitoring
-- Logs events that take longer than threshold (default: 0.5s)
log_slow_events_threshold = 0.5  -- seconds

-- mod_limits: Connection and bandwidth rate limiting (core module)
limits = {
    c2s = {
        rate = Lua.os.getenv("PROSODY_C2S_RATE_LIMIT") or "3kb/s";
        burst = "2s";             -- Allow bursts for 2 seconds
    };
    s2s = {
        rate = Lua.os.getenv("PROSODY_S2S_RATE_LIMIT") or "10kb/s";
        burst = "3s";
    };
}

-- mod_server_status: Monitoring endpoint
-- Provides status page at http://localhost:5280/server-status
-- (accessible only via localhost due to http_interfaces restriction)
server_status_show_hosts = true   -- Show VirtualHost statistics
server_status_show_comps = false  -- No components configured yet

-- mod_stanza_counter: XMPP stanza metrics
-- Counts messages, presence, iq stanzas for monitoring
-- Access stats via admin_telnet or mod_admin_web2

---------- PASTEBIN CONFIGURATION ----------

-- mod_pastebin: Convert large messages to pastebin links
-- NOTE: Pastebin is NOT encrypted - stored in plain text
-- Consider disabling if privacy is critical, or use external encrypted pastebin
pastebin_threshold = 500         -- Messages > 500 chars converted to paste
pastebin_line_threshold = 4      -- Or messages with > 4 lines
pastebin_expire_after = 86400    -- Pastes expire after 24 hours (seconds)
pastebin_trigger = "!paste"      -- Trigger word to force paste creation

---------- MUC COMPONENT CONFIGURATION ----------

-- Multi-User Chat (Group Chat) Component
-- Enable with PROSODY_MUC_ENABLED=true
if Lua.os.getenv("PROSODY_MUC_ENABLED") == "true" then
    local muc_domain = Lua.os.getenv("PROSODY_MUC_DOMAIN") or "conference.${XMPP_DOMAIN}"
    
    Component (muc_domain) "muc"
        name = Lua.os.getenv("PROSODY_MUC_NAME") or "Group Chat Rooms"
        modules_enabled = { "muc_mam", "vcard_muc", "pastebin" }
        
        -- Room creation restrictions
        restrict_room_creation = Lua.os.getenv("PROSODY_MUC_RESTRICT_CREATION") or "local"
        
        -- Default room settings
        muc_room_default_public = Lua.os.getenv("PROSODY_MUC_DEFAULT_PUBLIC") == "true"
        muc_room_default_persistent = Lua.os.getenv("PROSODY_MUC_DEFAULT_PERSISTENT") == "true"
        muc_room_default_members_only = Lua.os.getenv("PROSODY_MUC_DEFAULT_MEMBERS_ONLY") ~= "false"  -- default true
        muc_room_default_moderated = Lua.os.getenv("PROSODY_MUC_DEFAULT_MODERATED") ~= "false"  -- default true
        muc_room_default_public_jids = Lua.os.getenv("PROSODY_MUC_DEFAULT_PUBLIC_JIDS") == "true"
        muc_room_default_change_subject = Lua.os.getenv("PROSODY_MUC_DEFAULT_CHANGE_SUBJECT") == "true"
        muc_room_default_history_length = Lua.tonumber(Lua.os.getenv("PROSODY_MUC_DEFAULT_HISTORY")) or 20
        muc_room_default_language = Lua.os.getenv("PROSODY_MUC_DEFAULT_LANG") or "en"
        
        -- Pastebin settings for MUC
        pastebin_line_threshold = Lua.tonumber(Lua.os.getenv("PROSODY_MUC_PASTEBIN_LINES")) or 60
        pastebin_threshold = Lua.tonumber(Lua.os.getenv("PROSODY_MUC_PASTEBIN_CHARS")) or 5000
end
