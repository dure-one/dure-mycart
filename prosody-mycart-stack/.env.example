# Environment variables for dure-mycart + xmpp-proxy + prosody stack
# Copy this file to .env and fill in your values

# ============================================================================
# Image Tags (controls deployment mode)
# ============================================================================

# Deployment modes:
# - latest: Production (docker-compose.yml)
# - test: Testing (set MYCART_IMAGE_TAG=test)
# - dev: Development (docker-compose -f docker-compose.yml -f docker-compose.dev.yml)
MYCART_IMAGE_TAG=latest

# ============================================================================
# Required Variables
# ============================================================================

# Domain name (must be the same for both XMPP and mycart for shared SSL cert)
XMPP_DOMAIN=example.com
MYCART_DOMAIN=example.com

# XMPP admin user (JID format: user@domain)
XMPP_ADMIN=admin@example.com

# ============================================================================
# XMPP Routing (xmpp-proxy handles all XMPP traffic)
# ============================================================================

# All XMPP traffic is routed through xmpp-proxy to Prosody
# - QUIC (443/udp): XEP-0467 XMPP over QUIC
# - Direct TLS ports: 5222 (C2S), 5223 (Legacy SSL), 5269 (S2S)
# xmpp-proxy configuration is in prosody-mycart-stack/templates/xmpp-proxy.toml.template

# ============================================================================
# Mycart Configuration
# ============================================================================

# Development mode (true/false)
MYCART_DEV_MODE=false

# HTTP bind address
MYCART_HTTP_ADDR=0.0.0.0:80

# HTTPS bind address
MYCART_HTTPS_ADDR=0.0.0.0:443

# Gin framework mode (release/debug)
GIN_MODE=release

# Reverse proxy bindings (format: /path->http://target,/path2->http://target2)
# Multiple bindings separated by comma
# Note: Target URL must include the path prefix since proxy strips it before forwarding
# - /prosody: Admin web interface
# - /http-bind: BOSH endpoint (required for admin interface XMPP connection)
# - /xmpp-websocket: Native XMPP over WebSocket (XEP-0468)
# - /ws: WebSocket alias for client compatibility
# Use container hostname since prosody-mycart-stack is on bridge network
REVERSE_PROXY_BINDINGS=/prosody->http://prosody:5280/prosody,/http-bind->http://prosody:5280/http-bind,/xmpp-websocket->http://prosody:5280/xmpp-websocket,/ws->http://prosody:5280/xmpp-websocket

# ============================================================================
# Prosody Configuration
# ============================================================================

# Prosody admin JIDs (comma-separated)
# Default: Uses XMPP_ADMIN if set, otherwise admin@XMPP_DOMAIN
# PROSODY_ADMINS=admin@example.com

# Prosody virtual hosts (space-separated)
# Default: Uses XMPP_DOMAIN
# PROSODY_VIRTUAL_HOSTS=example.com

# Prosody certificate directory
# Default: /certs (shared volume with dure-mycart)
# PROSODY_CERTIFICATES=/certs

# Enabled Prosody modules (comma-separated)
# Default modules are security-hardened and include:
# - Core: mam, carbons, csi_simple, ping
# - Admin: admin_adhoc, admin_shell, http, admin_web2
# - HTTP: bosh, websocket
# - Security: ipcheck, anti_spam, limits
# - Monitoring: log_slow_events, server_status, stanza_counter
# - Utility: pastebin
# Note: Additional modules can be enabled via PROSODY_ENABLE_* variables below
# PROSODY_ENABLE_MODULES=mam,carbons,csi_simple,ping,admin_adhoc,admin_shell,http,admin_web2,bosh,websocket,ipcheck,anti_spam,log_slow_events,server_status,stanza_counter,pastebin,limits

# Prosody logging level (debug/info/warn/error)
PROSODY_LOGLEVEL=info

# Message retention in days (for Message Archive Management)
PROSODY_RETENTION_DAYS=90

# ============================================================================
# Prosody DANE/DNSSEC Configuration
# ============================================================================

# Enable DANE (DNS-Based Authentication of Named Entities)
# Requires: lua-unbound, dns-root-data packages
# Default: false (optional security enhancement)
PROSODY_USE_DANE=false

# DNS resolvers for DNSSEC queries (comma-separated)
# Example: 8.8.8.8,1.1.1.1 or 1.1.1.1,8.8.4.4
PROSODY_DNS_RESOLVERS=8.8.8.8,1.1.1.1

# ============================================================================
# Prosody Storage Configuration
# ============================================================================

# Storage backend (internal/sql)
# internal: Flat files in /var/lib/prosody (default)
# sql: Database backend (requires SQL config below)
PROSODY_STORAGE=internal

# SQL Configuration (only if PROSODY_STORAGE=sql)
# Supported drivers: SQLite3, MySQL, PostgreSQL
# Leave PROSODY_SQL_DRIVER empty to use internal storage
PROSODY_SQL_DRIVER=
PROSODY_SQL_DB=prosody
PROSODY_SQL_USERNAME=prosody
PROSODY_SQL_PASSWORD=
PROSODY_SQL_HOST=localhost

# ============================================================================
# Prosody Archiving & Retention
# ============================================================================

# Archive expiry in days (MAM message retention)
# Default: 7 days (falls back to PROSODY_RETENTION_DAYS if not set)
PROSODY_ARCHIVE_EXPIRY_DAYS=7

# ============================================================================
# Prosody Rate Limiting
# ============================================================================

# Client-to-Server rate limit (default: 3kb/s)
PROSODY_C2S_RATE_LIMIT=3kb/s

# Server-to-Server rate limit (default: 10kb/s)
PROSODY_S2S_RATE_LIMIT=10kb/s

# ============================================================================
# Prosody Statistics & Monitoring
# ============================================================================

# Enable statistics collection (empty=disabled, "internal"=enabled)
# Default: empty (disabled)
PROSODY_STATISTICS=

# Statistics collection interval in seconds (default: 60)
PROSODY_STATISTICS_INTERVAL=60

# ============================================================================
# Prosody Registration
# ============================================================================

# Allow user self-registration (default: false for security)
# Set to true only if you want open registration
PROSODY_ALLOW_REGISTRATION=false

# Welcome message for new users (variables: $username, $host)
PROSODY_WELCOME_MESSAGE=Welcome $username to $host XMPP server!

# Registration notifications (comma-separated admin JIDs)
# Requires mod_watchregistrations
PROSODY_REGISTRATION_WATCHERS=admin@example.com
PROSODY_REGISTRATION_NOTIFICATION=User $username registered on $host

# ============================================================================
# Prosody S2S Security
# ============================================================================

# S2S stanza size limit (default: 512KB)
PROSODY_S2S_STANZA_LIMIT=512000

# S2S insecure domains (allow dialback, comma-separated)
PROSODY_S2S_INSECURE_DOMAINS=

# S2S secure domains (require valid certs, comma-separated)
PROSODY_S2S_SECURE_DOMAINS=

# ============================================================================
# Prosody MAM (Message Archive Management)
# ============================================================================

# Default archive policy (true = archive all messages)
PROSODY_MAM_DEFAULT_POLICY=true

# Archive cleanup interval in seconds (default: 4 hours)
PROSODY_MAM_CLEANUP_INTERVAL=14400

# Maximum archive query results (default: 20)
PROSODY_MAM_MAX_RESULTS=20

# ============================================================================
# Prosody MUC (Multi-User Chat) Logging
# ============================================================================

# Log MUC messages by default
PROSODY_MUC_LOG_DEFAULT=false

# Log presence changes in MUC rooms
PROSODY_MUC_LOG_PRESENCES=false

# Log all rooms (not just configured ones)
PROSODY_MUC_LOG_ALL_ROOMS=false

# MUC log expiry in days (default: 14 days)
PROSODY_MUC_LOG_EXPIRES=14

# MUC cleanup interval in seconds (default: 4 hours)
PROSODY_MUC_CLEANUP_INTERVAL=14400

# ============================================================================
# Prosody MUC Component (Group Chat Rooms)
# ============================================================================

# Enable MUC component (default: false)
PROSODY_MUC_ENABLED=false

# MUC subdomain (default: conference.XMPP_DOMAIN)
PROSODY_MUC_DOMAIN=conference.example.com

# MUC service name
PROSODY_MUC_NAME=Group Chat Rooms

# Room creation restriction (local/admin/false)
PROSODY_MUC_RESTRICT_CREATION=local

# Default room settings
PROSODY_MUC_DEFAULT_PUBLIC=false
PROSODY_MUC_DEFAULT_PERSISTENT=false
PROSODY_MUC_DEFAULT_MEMBERS_ONLY=true
PROSODY_MUC_DEFAULT_MODERATED=true
PROSODY_MUC_DEFAULT_PUBLIC_JIDS=false
PROSODY_MUC_DEFAULT_CHANGE_SUBJECT=false
PROSODY_MUC_DEFAULT_HISTORY=20
PROSODY_MUC_DEFAULT_LANG=en

# MUC pastebin settings
PROSODY_MUC_PASTEBIN_LINES=60
PROSODY_MUC_PASTEBIN_CHARS=5000

# ============================================================================
# Prosody Module Toggles
# ============================================================================

# Admin modules (default: enabled)
PROSODY_ENABLE_ADMIN_ADHOC=true
PROSODY_ENABLE_ADMIN_SHELL=true

# HTTP modules (default: enabled, required for web admin)
PROSODY_ENABLE_BOSH=true
PROSODY_ENABLE_WEBSOCKET=true

# ============================================================================
# fail2ban-rs Configuration (optional overrides)
# ============================================================================

# Maximum retry attempts before banning (default: 5)
# FAIL2BAN_MAX_RETRY=5

# Time window to count failures (default: 10m)
# FAIL2BAN_FIND_TIME=10m

# Ban duration (default: 1h)
# FAIL2BAN_BAN_TIME=1h

# ============================================================================
# User/Group IDs (for volume permissions)
# ============================================================================

USER_UID=1000
USER_GID=1000

# ============================================================================
# Notes
# ============================================================================
# - XMPP_DOMAIN and MYCART_DOMAIN MUST match for shared SSL certificate
# - SSL certificates are automatically managed by dure-mycart's autocert
# - Certificates are stored in /certs volume and shared with xmpp-proxy
# - Logs are stored in /logs volume
# - Prosody admin interface: https://YOUR_DOMAIN/prosody/admin/
# - REVERSE_PROXY_BINDINGS is required for Prosody web admin access
#
# Architecture:
# - dure-mycart: HTTP only on 80/tcp (ACME challenges, web traffic)
# - xmpp-proxy: XMPP on 443/udp (QUIC), 5222, 5223, 5269/tcp (Direct TLS)
# - prosody: XMPP server backend (receives only from xmpp-proxy)
#
# Advanced Configuration:
# - DANE/DNSSEC: Requires lua-unbound and dns-root-data packages in container
# - SQL Storage: Requires lua-dbi-postgresql/mysql/sqlite3 packages
# - Statistics: Enable with PROSODY_STATISTICS=internal for monitoring
# - Registration: Keep false for security (prevent spam accounts)
# - MUC Component: Enable with PROSODY_MUC_ENABLED=true for group chat
# - MAM: Message archiving enabled by default (PROSODY_MAM_DEFAULT_POLICY=true)
#
# IMPORTANT - S2S Security:
# - s2s_secure_auth is DISABLED in config (this is CORRECT and SECURE)
# - Certificate validation happens in xmpp-proxy, not Prosody
# - See XMPP-PROXY-S2S-CERT-VALIDATION.md for security verification
# - Do NOT enable s2s_secure_auth or federation will break!
